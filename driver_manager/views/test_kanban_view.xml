<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <record id="test_kanban_view_tree" model="ir.ui.view">
        <field name="name">test.kanban.view.list</field>
        <field name="model">test.kanban</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="description"></field>
                <field name="date_order"></field>
                <field name="state"></field>
                <field name="activity_state"></field>
                
            </list>
        </field>
    </record>

    <record id="test_kanban_view_form" model="ir.ui.view">
        <field name="name">test.kanban.view.form</field>
        <field name="model">test.kanban</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"></field>
                        <field name="description"></field>
                        <field name="date_order"></field>
                        <field name="state"></field>
                        <field name="activity_state"></field>
                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- kanban view  -->

    <record id="test_kanban_view_kanban" model="ir.ui.view">
        <field name="name">test.kanban.view.kanban</field>
        <field name="model">test.kanban</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                <!-- <progressbar field="activity_state" col                               00ors='{"planned":"success","today":"warning","overdue":"danger"}'/> -->
                <templates>
                    <!-- <t t-name="kanban-box"> -->
                    <t t-name="card">
                    <div class="p-3 d-flex ">
                        <field  name="name" /> 
                        <field name="state" widget="label_selection"  options="{'classes':{'draft':'info','done':'primary','in-progress':'success'}}" class='ms-auto' /> <br/>
                    </div>
                    <div class="p-3 d-flex">

                        <field  name="date_order" />
                    </div>
                    <footer class="p-3 d-flex justify-content-center align-items-center">
                        <div>
                            <field name="description" />
                            
                        </div>
                        
                    </footer>
                        
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    


     <record id="test_kanban_action" model="ir.actions.act_window">
        <field name="name">Kanban</field>
        <field name="res_model">test.kanban</field>
        <field name="view_mode">list,form,kanban</field>
            <!-- used to set default search view  -->
        <!-- <field name="context">{'search_default_male_drivers': 1}</field> -->
    </record>

</odoo>
