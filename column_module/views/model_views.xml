<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <record id="column_model_view_tree" model="ir.ui.view">
        <field name="name">column.model.view.list</field>
        <field name="model">column.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="name1" />
                <field name="name2" />
                <field name="name3" />
                <field name="name4" />
                <field name="name5" />

            </list>
        </field>
    </record>


    <record id="column_model_view_form" model="ir.ui.view">
        <field name="name">column.model.view.form</field>
        <field name="model">column.model</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="row">
                        <div class="d-flex flex-column col-4">
                            <group>
                                <field name="name" />
                                <field name="name1" />
                            </group>

                        </div>
                        <div class="d-flex flex-column col-4">
                            <group>
                                <field name="name2" />
                                <field name="name3" />
                            </group>


                        </div>
                        <div class="d-flex flex-column col-4">
                            <group>
                                <field name="name4" />
                                <field name="name5" />
                            </group>

                        </div>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="column_model_action" model="ir.actions.act_window">
        <field name="name">Column View</field>
        <field name="res_model">column.model</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>