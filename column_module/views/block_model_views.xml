<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="block_model_view_list" model="ir.ui.view">
        <field name="name">block.model.view.tree</field>
        <field name="model">block.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="block_name" />
                <field name="property_id" />
                <field name="user_id" />
                <field name="company_id" />

            </list>
        </field>
    </record>


    <record id="block_model_view_form" model="ir.ui.view">
        <field name="name">block.model.view.form</field>
        <field name="model">block.model</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div>
                        <p class="fw-bold m-0">BLOCK DETAILS</p>
                        <hr/>
                        <div class="row p-3">
                            <div class="col-6">
                                <group>
                                    <field name="block_name" />
                                    <field name="property_id" />


                                </group>

                            </div>
                            <div class="col-6">
                                <group>
                                    <field name="user_id" />
                                    <field name="company_id" />
                                </group>

                            </div>

                        </div>
                    </div>


                </sheet>
            </form>
        </field>
    </record>



    <record id="block_model_action" model="ir.actions.act_window">
        <field name="name">Block View</field>
        <field name="res_model">block.model</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>