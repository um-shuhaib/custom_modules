<?xml version="1.0" encoding="utf-8"?>
<!-- <?xml-stylesheet type="text/css" href="https://cdn.jsdelivr.net"?> -->

    <templates xml:space="preserved">
        <t t-name="owl_module.TodoList" owl="1">
            <div class="vh-100 d-flex flex-column justify-content-center align-items-center p-5 bg-dark">
                <h1 class="text-center text-light">COUNTER</h1>
                <div class="bg-secondary d-flex justify-content-center align-items-center">
                    <button t-on-click="decrement"  class="btn btn-danger m-3"> - </button>
                    <input type="text" t-att-value="state.value" class="form-control w-50" />
                    <button t-on-click="increment" class="btn btn-success m-3"> + </button>
                </div>
            
            </div>

        </t>
        
    </templates>

