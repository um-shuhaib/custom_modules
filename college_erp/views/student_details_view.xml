<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="student_details_view_tree" model="ir.ui.view">
        <field name="name">student_details.view.tree</field>
        <field name="model">student.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="place" />
                
            </list>
        </field>
    </record>

    <record id="student_details_view_form" model="ir.ui.view">
        <field name="name">student_details.view.form</field>
        <field name="model">student.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="place" />
                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_details_action" model="ir.actions.act_window">
        <field name="name">Student Details</field>
        <field name="res_model">student.details</field>
        <field name="view_mode">list,form</field>
        
        
    </record>

</odoo>
